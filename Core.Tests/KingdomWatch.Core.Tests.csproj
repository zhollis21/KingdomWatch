<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>KingdomWatch.Core.Tests</AssemblyName>
    <RootNamespace>KingdomWatch.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Tests run on Microsoft.Testing.Platform, not VSTest (#204): the project
    builds into an executable that runs its own tests, and global.json puts
    dotnet test in MTP mode. Set here rather than in Directory.Build.props,
    which also reaches Core, and OutputType Exe would make Core a program.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\KingdomWatch.Core.csproj" />
    <!-- For SchedulerSoak: the performance tests bound the exact workload the harness reports on. -->
    <ProjectReference Include="..\Harness\KingdomWatch.Harness.csproj" />
  </ItemGroup>

</Project>

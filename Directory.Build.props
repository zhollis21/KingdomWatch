<Project>

  <!--
    Shared build settings for the standalone .NET projects (Core, Core.Tests,
    Harness). MSBuild walks up from every project it evaluates, so an empty
    Game/Directory.Build.props stops this file from reaching the .csproj files
    Unity regenerates on import. Do not remove that stopper.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!--
      Implicit usings inject a different set per target framework, so code that
      compiles in the net10.0 test project would not necessarily compile in
      netstandard2.1 Core. Explicit usings keep the two honest.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>

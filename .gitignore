# === Unity project (Game/) ===
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore,
# scoped to the Unity project's subfolder since this repo also holds
# plain .NET projects (Core, Core.Tests, Harness) at its root.

.utmp/
Game/[Ll]ibrary/
Game/[Tt]emp/
Game/[Bb]uild/
Game/[Bb]uilds/
Game/[Ll]ogs/
Game/ProfilerCaptures/
Game/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# Game/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
# (Unity writes these directly in the Unity project root only —
# scoped so hand-authored .csproj/.sln for Core/Tests/Harness are kept)
Game/ExportedObj/
.consulo/
Game/*.csproj
*.unityproj
Game/*.sln
Game/*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
Game/InitTestScene*.unity*

# Addressables default ignores, before user customizations
Game/ServerData
Game/[Aa]ssets/StreamingAssets/aa*
Game/[Aa]ssets/AddressableAssetsData/link.xml*
Game/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# Game/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
Game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
Game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
Game/[Aa]ssets/[Ss]ceneDependencyCache*

# === .NET projects (Core/, Core.Tests/, Harness/) ===
**/[Bb]in/
**/[Oo]bj/

# === Claude Code / Codex CLI local files ===
.claude/**/*.local*
# Codex CLI auto-syncs its own local skill cache from .claude/skills here;
# don't commit it — .claude/skills is the single source of truth.
.agents/skills
.codex/

# tools/ holds a few scripts that are actually part of the repo, plus
# generated/local output (pr-comments.md). Ignore the directory's contents,
# then allow-list the real scripts. (Must be `tools/*`, not `tools/` — a
# directory-matching ignore can't be un-ignored file by file afterward.)
tools/*
!tools/Get-OpenPrComments.ps1

# Editor/IDE settings are per-contributor, not a repo convention here.
.vscode/
